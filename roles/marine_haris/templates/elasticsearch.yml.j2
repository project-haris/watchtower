# roles/marine_haris/templates/elasticsearch.yml.j2

cluster.name: "marine-haris-cluster"
node.name: "node-{{ haris_vessel_id }}"
path.data: /var/lib/elasticsearch
path.logs: /var/log/elasticsearch

# Bind to localhost for security (Pi is edge device)
network.host: localhost
http.port: 9200

# --- Security Configuration ---
# Disable security for local development/testing on Pi
xpack.security.enabled: false

# CRITICAL: Explicitly disable SSL to override installer defaults
# This prevents the conflict with auto-generated keystore passwords
xpack.security.enrollment.enabled: false
xpack.security.http.ssl.enabled: false
xpack.security.transport.ssl.enabled: false

# --- Performance Tuning for Raspberry Pi ---
# Since this is likely a single-node instance on a boat
discovery.type: single-node