filebeat.inputs:
  - type: filestream
    id: haris-signalk
    enabled: true
    paths:
      - {{ haris_filebeat_log_path }}
    parsers:
      - ndjson:
          target: ""
          overwrite_keys: true

output.logstash:
  hosts:
    - "{{ haris_filebeat_logstash_host }}:{{ haris_filebeat_logstash_port }}"

logging.to_files: true
logging.files:
  path: /var/log/filebeat
  name: filebeat
  keepfiles: 7
  permissions: 0644
