[Unit]
Description=Signal K Server for {{ haris_vessel_name }}
Documentation=https://signalk.org
After=network.target

[Service]
Type=simple
User={{ haris_user }}
Group={{ haris_group }}
WorkingDirectory={{ haris_home }}
Environment="HOME={{ haris_home }}"
Environment="PATH=/usr/local/bin:/usr/bin:/bin"
ExecStart=/usr/local/bin/signalk-server --port {{ haris_signalk_port }}
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
